+// requireBearerToken rejects requests that do not carry the shared token.
+// Accepts either `Authorization: Bearer <token>` or `X-Engram-Token: <token>`.
+// Comparison is constant-time so a wrong token leaks no timing information.
+func requireBearerToken(next http.Handler, token string) http.Handler {
+	want := []byte(token)
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got := strings.TrimSpace(r.Header.Get("X-Engram-Token"))
+		if got == "" {
+			got = strings.TrimSpace(strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer "))
+		}
+		if subtle.ConstantTimeCompare([]byte(got), want) != 1 {
+			log.Printf("[engram] 401 %s %s from %s", r.Method, r.URL.Path, r.RemoteAddr)
+			w.Header().Set("WWW-Authenticate", `Bearer realm="engram"`)
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// tokenRecord is one entry in the token list file. Extra fields in the JSON
+// (note, created_at, …) are owned by the admin panel and ignored here.
+type tokenRecord struct {
+	Token   string `json:"token"`
+	Revoked bool   `json:"revoked"`
+}
+
+// tokenList is the set of valid bearer tokens, backed by a JSON file that is
+// reloaded whenever its mtime/size changes. It is safe for concurrent use.
+type tokenList struct {
+	path    string
+	mu      sync.Mutex
+	modTime time.Time
+	size    int64
+	tokens  map[string]tokenRecord
+	loadErr error
+}
+
+func loadTokenList(path string) *tokenList {
+	t := &tokenList{path: path}
+	t.reload(true)
+	if t.loadErr != nil {
+		log.Printf("[engram] WARNING: token list %s not readable yet (%v) — all requests will be 401 until it is", path, t.loadErr)
+	}
+	return t
+}
+
+func (t *tokenList) reload(force bool) {
+	fi, err := os.Stat(t.path)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if err != nil {
+		t.tokens = nil
+		t.loadErr = err
+		return
+	}
+	if !force && !fi.ModTime().After(t.modTime) && fi.Size() == t.size {
+		return
+	}
+	data, err := os.ReadFile(t.path)
+	if err != nil {
+		t.tokens = nil
+		t.loadErr = err
+		return
+	}
+	var m map[string]tokenRecord
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.tokens = nil
+		t.loadErr = fmt.Errorf("token list %s is not valid JSON: %w", t.path, err)
+		log.Printf("[engram] %v — keeping auth fail-closed", t.loadErr)
+		return
+	}
+	t.tokens = m
+	t.modTime = fi.ModTime()
+	t.size = fi.Size()
+	t.loadErr = nil
+	log.Printf("[engram] token list reloaded: %d entries", len(m))
+}
+
+// check reports whether got is a known, non-revoked token. Any load problem
+// fails closed. Comparison runs over every entry in constant time per entry,
+// so a wrong token leaks neither timing nor which entry it nearly matched.
+func (t *tokenList) check(got string) bool {
+	t.reload(false)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.loadErr != nil || got == "" {
+		return false
+	}
+	matchedRevoked := false
+	ok := false
+	for _, rec := range t.tokens {
+		if subtle.ConstantTimeCompare([]byte(got), []byte(rec.Token)) == 1 {
+			if rec.Revoked {
+				matchedRevoked = true
+			} else {
+				ok = true
+			}
+		}
+	}
+	return ok && !matchedRevoked
+}
+
+// requireTokenListAuth is the token-list variant of requireBearerToken.
+func requireTokenListAuth(next http.Handler, list *tokenList) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got := strings.TrimSpace(r.Header.Get("X-Engram-Token"))
+		if got == "" {
+			got = strings.TrimSpace(strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer "))
+		}
+		if !list.check(got) {
+			log.Printf("[engram] 401 %s %s from %s", r.Method, r.URL.Path, r.RemoteAddr)
+			w.Header().Set("WWW-Authenticate", `Bearer realm="engram"`)
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
